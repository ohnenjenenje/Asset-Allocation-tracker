# ==========================================
# Asset Tracker Environment Variables
# ==========================================

# 1. AI & LLM Keys
# The mobile assistant exposes one provider per configured key and fetches the
# model list from that provider. Add one or more keys per provider, comma-
# separated. Requests rotate through the pool and keys that hit a rate limit are
# cooled down before being retried. Never expose these as EXPO_PUBLIC_* values;
# they stay on the Next.js server.
GROQ_API_KEYS="gsk_key_one,gsk_key_two"
# Older single-key form, still supported and merged into the same pool.
# GROQ_API_KEY="gsk_your_groq_key_here"

# OpenRouter (sk-or-v1-…) and Gemini (AIza…) keys are optional. Gemini also
# accepts NEXT_PUBLIC_GEMINI_API_KEY below, which the web app already uses.
OPENROUTER_API_KEYS=""
GEMINI_API_KEYS=""

NEXT_PUBLIC_GEMINI_API_KEY="your_gemini_api_key_here"

# Signed-in users can also add their own keys in the app under
# Settings -> AI assistant -> API keys. Those are stored in MongoDB.
# Firebase project whose ID tokens the assistant routes verify.
FIREBASE_PROJECT_ID="your_firebase_project_id"

# 2. Database & Sync
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/asset_tracker?retryWrites=true&w=majority"

# 3. Cryptocurrency Exchanges
BINANCE_API_KEY="your_binance_api_key"
BINANCE_SECRET="your_binance_api_secret"

COINDCX_API_KEY="your_coindcx_api_key"
COINDCX_SECRET="your_coindcx_api_secret"

# 4. External APIs (Stocks & Mutual Funds)
INDIAN_API_ENDPOINTS="https://api1.example.com,https://api2.example.com"
INDIAN_API_KEYS="key1,key2"
# Monthly allowance used by the in-app IndianAPI usage indicator (default 500).
INDIAN_API_MONTHLY_LIMIT=500
MF_API_ENDPOINTS="https://mfapi.example.com"

# 4b. Market data policy
# Indian equity quotes use Groww and Moneycontrol public website endpoints.
# They need no API key, but they are unofficial and can be blocked or changed.
# Keep true for a personal deployment; set false before sharing publicly.
ALLOW_UNOFFICIAL_QUOTES=true

# /api/price protection. Limits are per IP and per minute; the symbol cap is
# per request. Raise the symbol cap only if your portfolio needs it.
PRICE_API_RATE_LIMIT=120
PRICE_API_SYNC_RATE_LIMIT=60
PRICE_API_MAX_SYMBOLS=250

# 5. Google Sheets Integration
GOOGLE_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourKeyHere\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="your_google_sheet_id_here"
