# Backend API (Next.js on Render)
EXPO_PUBLIC_API_URL=https://portfolio-tracker-hjvx.onrender.com

# Firebase (same project as web app — copy values from the web app config)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIRESTORE_DATABASE_ID=

# Google sign-in (optional) — requires a development build (not Expo Go)
# Web client id, also registered as "Web application" in Google Cloud Console
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# iOS client id (only needed on iOS)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
