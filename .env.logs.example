# Per-project log integration — copy to .env.logs and fill with THAT project's credentials
# This file is committed as example; .env.logs (real) is gitignored per folder.

# BetterStack (preferred for live runtime logs)
# 1. BetterStack -> Settings -> API tokens -> Telemetry API tokens -> Create
BETTERSTACK_API_TOKEN=
# Telemetry -> Sources -> your source -> copy the numeric source ID.
# With this set, the script uses the v2 Query API and no SQL setup is needed.
BETTERSTACK_SOURCE_ID=
# Source/Ingest token for Render Log Streams (syslog+tls://TOKEN@in.logs.betterstack.com)
BETTERSTACK_SOURCE_TOKEN=
# Optional SQL API fallback: Integrations -> SQL API -> Connect ClickHouse -> Create
# Copy Host / Username / Password / Source table
BETTERSTACK_SQL_HOST=
BETTERSTACK_SQL_USER=
BETTERSTACK_SQL_PASSWORD=
BETTERSTACK_SOURCE_TABLE=

# Render (deploy logs fallback)
# Render -> Account Settings -> API Keys -> Create
RENDER_API_KEY=
# Render -> Service -> Settings -> Service ID (srv-xxx)
RENDER_SERVICE_ID=
# Multiple: RENDER_SERVICE_IDS=srv-aaa,srv-bbb
